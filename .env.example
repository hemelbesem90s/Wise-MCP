# ==============================================================================
# Wise Hybrid MCP Server Environment Configuration
# ==============================================================================

# Wise API Bearer Token
# (Recommended: Store securely in OS Keyring via 'wise-mcp --set-token <token>')
WISE_MCP_API_TOKEN=your-wise-api-token-here

# Wise API Base URL
# Production: https://api.wise.com
# Sandbox:    https://api.sandbox.transferwise.tech
WISE_MCP_API_URL=https://api.wise.com

# Default Wise Profile ID (optional)
# If omitted and your token has exactly one profile, it is selected automatically.
# WISE_MCP_PROFILE_ID=12345678

# Strong Customer Authentication (SCA) RSA Private Key
# (Recommended: Generate and store in OS Keyring via 'wise-mcp --generate-sca-keys')
# Alternatively, specify a local PEM file path or inline PEM string:
# WISE_MCP_SCA_PRIVATE_KEY_PATH=~/.config/wise/private.pem
# WISE_MCP_SCA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."

# Security Gates
# Lock 1: Enable write tools (create_quote, create_recipient, stage_transfer, fund_transfer)
WISE_MCP_ENABLE_WRITE_TOOLS=false

# Lock 3: Require native Touch ID / Windows Hello biometric verification for write actions
WISE_MCP_REQUIRE_BIOMETRIC=true

# OS Keyring Service Name
WISE_MCP_KEYRING_SERVICE=wise_mcp

# Logging Level (DEBUG, INFO, WARNING, ERROR)
WISE_MCP_LOG_LEVEL=WARNING

# Strict host whitelist override (TESTING ONLY)
WISE_MCP_ALLOW_CUSTOM_API_URL=false
